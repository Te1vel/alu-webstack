#!/usr/bin/env bash
# Displays information about subdomains of a domain
# shellcheck disable=SC2086

get_info() {
    local domain=$1
    local name=$2
    dig "$name.$domain" | grep -A1 'ANSWER SECTION:' | tail -1 \
        | awk -v name="$name" '{print "The subdomain " name " is a " $4 " record and points to " $5}'
}

if [ $# -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        get_info "$1" "$sub"
    done
elif [ $# -eq 2 ]; then
    get_info "$1" "$2"
fi
